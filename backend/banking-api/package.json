{
  "name": "finguard-banking-api",
  "version": "1.0.0",
  "description": "Shield - API bancaire NestJS avec moteur intelligent de détection de fraude",
  "private": true,
  "scripts": {
    "start": "ts-node src/main.ts",
    "start:dev": "ts-node-dev --respawn --transpile-only src/main.ts",
    "db:create": "ts-node scripts/create-mysql-database.ts",
    "db:init": "ts-node scripts/init-db.ts",
    "db:seed": "ts-node scripts/seed.ts",
    "db:reset": "ts-node scripts/init-db.ts --reset && ts-node scripts/seed.ts",
    "db:setup": "ts-node scripts/init-db.ts && ts-node scripts/seed.ts",
    "test:e2e": "node --test tests/e2e.test.mjs"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.4",
    "@nestjs/config": "^3.2.3",
    "@nestjs/core": "^10.4.4",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.4.4",
    "@nestjs/swagger": "^7.4.2",
    "bcryptjs": "^2.4.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "mysql2": "^3.11.5",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^4.17.21",
    "@types/node": "^22.7.4",
    "@types/passport-jwt": "^4.0.1",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.5.4"
  }
}
