# Shield — variables d'environnement (exemple)
# Copier vers .env et adapter.

# JWT
JWT_SECRET=shield-dev-secret
JWT_EXPIRES_IN=12h

# MySQL
# MYSQL_HOST=127.0.0.1
# MYSQL_PORT=3306
# MYSQL_USER=root
# MYSQL_PASSWORD=change-me
# MYSQL_DATABASE=shield
# Alternatively, provide a mysql://... DATABASE_URL.

# ---------------------------------------------------------------
# Assistant IA — modèle de langage externe (optionnel, "LLM-ready")
# Sans ces variables, l'assistant utilise le moteur NLU intégré
# (100 % hors-ligne, gratuit). En cas d'échec du LLM, repli
# automatique sur le moteur intégré.
# ---------------------------------------------------------------

# Option 1 — Google Gemini, GRATUIT (recommandé)
# Clé gratuite : https://aistudio.google.com/apikey
# LLM_PROVIDER=gemini
# LLM_API_KEY=AIza...
# LLM_MODEL=gemini-2.5-flash        # optionnel (défaut : gemini-2.5-flash)
# # LLM_BASE_URL auto : https://generativelanguage.googleapis.com/v1beta/openai

# Option 2 — OpenAI ou tout endpoint compatible
# (OpenRouter, Mistral, Ollama local…)
# LLM_PROVIDER=openai
# LLM_API_KEY=sk-...
# LLM_MODEL=gpt-4o-mini             # optionnel
# LLM_BASE_URL=https://api.openai.com/v1
