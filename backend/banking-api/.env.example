# Shield — variables d'environnement (exemple)
# Copier vers .env et adapter.

# JWT
JWT_SECRET=finguard-dev-secret
JWT_EXPIRES_IN=12h

# Base SQLite (exécution démo)
# SQLITE_PATH=./data/finguard.db

# ---------------------------------------------------------------
# Assistant IA — adaptateur LLM externe (optionnel, "LLM-ready")
# Sans ces variables, l'assistant utilise le moteur NLU intégré.
# Compatible avec tout endpoint type OpenAI (OpenAI, OpenRouter,
# Mistral, Ollama en local…).
# ---------------------------------------------------------------
# LLM_PROVIDER=openai
# LLM_API_KEY=sk-...
# LLM_MODEL=gpt-4o-mini
# LLM_BASE_URL=https://api.openai.com/v1
